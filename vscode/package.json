{
  "name": "slop-chop",
  "displayName": "slop-chop",
  "description": "Flag and chop AI writing tells in Markdown, text, commit messages, and code comments as you write. The engine runs inside the extension; your text never leaves your machine.",
  "version": "0.55.1",
  "publisher": "dcadolph",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://slop-chop.com",
  "bugs": {
    "url": "https://github.com/dcadolph/slop-chop/issues"
  },
  "keywords": [
    "ai",
    "writing",
    "prose",
    "markdown",
    "comments",
    "linter",
    "slop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dcadolph/slop-chop.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:plaintext",
    "onLanguage:git-commit",
    "onLanguage:go",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:rust",
    "onLanguage:java",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:kotlin",
    "onLanguage:swift",
    "onLanguage:php",
    "onLanguage:ruby",
    "onLanguage:shellscript",
    "onLanguage:yaml",
    "onLanguage:toml",
    "onLanguage:lua",
    "onLanguage:sql",
    "onLanguage:dart",
    "onLanguage:scala",
    "onLanguage:perl",
    "onLanguage:r",
    "onLanguage:terraform",
    "onLanguage:proto3",
    "onLanguage:fish",
    "onLanguage:makefile",
    "onLanguage:dockerfile"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "slop-chop.chop",
        "title": "slop-chop: Chop the slop"
      }
    ],
    "configuration": {
      "title": "slop-chop",
      "properties": {
        "slop-chop.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to a slop-chop binary to run instead of the bundled engine. Empty uses the bundled engine. Machine-scoped, so a workspace cannot point it at a repo-local executable."
        },
        "slop-chop.preset": {
          "type": "string",
          "default": "cleaver",
          "description": "Preset to apply. Empty for the default profile only."
        },
        "slop-chop.codeComments": {
          "type": "boolean",
          "default": true,
          "description": "Check the comments in source files. Only comment text is read and only fixable tells inside comments are changed. The code itself is never read or reformatted."
        }
      }
    }
  }
}
